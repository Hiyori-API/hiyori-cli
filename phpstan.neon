includes:
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    level: 5
    # `public/` holds the front controller (index.php) and its export helpers.
    # It used to be outside the analysed surface even though every
    # unauthenticated route lives there, so the riskiest code in the project was
    # never type-checked. Analyse it alongside src.
    #
    # `treatPhpDocTypesAsCertain: false` was used here to silence the 22
    # redundant-guard diagnostics that adding `public/` produced. That flag is a
    # global loss of signal (it also stops reporting dead `??`/`isset`/ternary
    # checks across src), so the guards themselves were removed and the flag is
    # gone. Keep it out: if a new finding appears, fix the guard or the PHPDoc.
    paths:
        - src
        - public
    excludePaths:
        - tests
