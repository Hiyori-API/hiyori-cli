includes:
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    level: 5
    # `public/` holds the front controller (index.php) and its export helpers.
    # It used to be outside the analysed surface even though every
    # unauthenticated route lives there, so the riskiest code in the project was
    # never type-checked. Analyse it alongside src.
    paths:
        - src
        - public
    excludePaths:
        - tests
    # public/index.php and public/export-helpers.php were written against the
    # Exporter's PHPDoc array shapes, which makes their defensive `??`, `?:` and
    # isset() guards look redundant ("else branch is unreachable", "offset
    # always exists"). Those 22 diagnostics are listed in the hardening report
    # and are harmless, but the files are not owned by this change, so treat
    # PHPDoc types as advisory rather than certain. Flip this back to the default
    # (true) once those guards are cleaned up.
    treatPhpDocTypesAsCertain: false
