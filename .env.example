# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# APP_DEBUG is the only mode switch the application reads (log verbosity and
# HTTP-client debug output). There is no APP_ENV: nothing branches on it.
APP_DEBUG=true
APP_VERSION=0.1.0

MONGODB_URL=mongodb://localhost:27017

HTTP_CACHE=false
HTTP_CACHE_PATH=/tmp/hiyori-http-cache
HTTP_CACHE_TTL=86400

PROGRESSBAR_FORMAT=%current%/%max% [%bar%] %percent:3s%% | ETA:%estimated:-6s% MEM:%memory:6s%
PROGRESSBAR_REDRAW_FREQ=1

# MyAnimeList Official API v2 (https://myanimelist.net/apiconfig).
# Only the client ID is used; MAL's public API does not take a client secret.
MAL_CLIENT_ID=
# Optional ceiling for MAL ranking pages (0 = run until the ranking is exhausted).
MAL_MAX_PAGES=0

# Dashboard
# DASHBOARD_TOKEN=            # optional bearer token for /api/* — the SPA does not send it, so enabling this blocks the UI
# WEBHOOK_URL=                # optional Slack/Generic webhook for alerts
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=60

# Scheduler (Dashboard → Sources). Both fall back to the defaults shown.
# SCHEDULE_SOURCES=anilist,kitsu,myanimelist
# SCHEDULE_INTERVAL=86400

# Level-0 local embeddings for `combine --strategy=semantic_rerank`.
# See services/ml/README.md; unset falls back to the offline n-gram hasher.
#
# The sidecar needs its own interpreter: `python3` on PATH does not have
# sentence-transformers. Install the venv first (services/ml/README.md):
#   python3 -m venv .venv-ml && .venv-ml/bin/pip install -r services/ml/requirements.txt
# ML_EMBED_COMMAND=/abs/path/.venv-ml/bin/python /abs/path/services/ml/embed.py
#
# ML_MODEL picks the sentence-transformers model. Multilingual, MIT-licensed
# and small enough to run on CPU:
#   intfloat/multilingual-e5-small          (384 dims, MIT)  — recommended
#   Alibaba-NLP/gte-modernbert-base         (768 dims, Apache-2.0)
# ML_MODEL=intfloat/multilingual-e5-small
#
# Bump ML_EMBED_VERSION whenever the model or the preprocessing changes: the
# embedding cache is keyed by (model, version, text), so a stale version
# would mix vectors from two models.
# ML_EMBED_VERSION=e5-small-1

# Level-2 LLM judge (`ml:llm-judge`). Without LLM_API_KEY every call is a
# no-op and the pipeline is unchanged. See docs/ml-augmentation-design.md.
# LLM_PROVIDER=openai         # openai (default) | anthropic
# LLM_MODEL=gpt-4o-mini       # anthropic default: claude-3-5-haiku-20241022
# LLM_API_KEY=
# LLM_BUDGET_USD=5.00         # hard cap on estimated spend per run
# LLM_MAX_PAIRS_PER_RUN=2000  # hard cap on API calls per run

# Telemetry output directory (defaults to storage/state).
# HIYORI_TELEMETRY_DIR=

# Alerts -> AlertNotifier multi-channel delivery (all optional; see docs/dashboard-roadmap.md)
# TELEGRAM_BOT_TOKEN=         # + TELEGRAM_CHAT_ID -> Telegram sendMessage (Markdown)
# TELEGRAM_CHAT_ID=
# SMTP_HOST=                  # SMTP transport for e-mail alerts (falls back to mail() when unset)
# SMTP_PORT=587
# SMTP_SECURE=tls             # tls (STARTTLS) | ssl | empty/plaintext
# SMTP_USER=                  # optional AUTH LOGIN credentials
# SMTP_PASS=
# SMTP_FROM=                  # sender; defaults to SMTP_USER or no-reply@localhost
# ALERT_EMAIL_TO=             # e-mail recipient


# Publishing (php hiyori publish / php hiyori db:push)
# Target empty HiyoriDB repository (owner/repo or full URL).
GITHUB_REPO=https://github.com/Hiyori-API/HiyoriDB.git
# Classic / fine-grained PAT with Contents:Read & Write on Hiyori-API/HiyoriDB.
# GITHUB_TOKEN=
# Tier B compressed releases (`php hiyori release / db:release`) reuse GITHUB_TOKEN
# In CI, prefer a dedicated `HIYORI_DB_TOKEN` repo secret for cross-repo access;
# and GITHUB_REPO. Deterministic archives honor SOURCE_DATE_EPOCH when set.
# HIYORI_DB_TOKEN=
# SOURCE_DATE_EPOCH=0
