{
    "name": "hiyori/cli",
    "description": "Relational Anime and Manga Database",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Hiyori\\": "src/"
        }
    },
    "authors": [
        {
            "name": "nekomata"
        }
    ],
    "require": {
        "jms/serializer": "^3.28",
        "mongodb/mongodb": "^2.0",
        "symfony/http-client": "^6.4",
        "symfony/console": "^6.4",
        "symfony/lock": "^6.4",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/dotenv": "^6.4",
        "ext-mongodb": "*",
        "symfony/http-kernel": "^6.4",
        "monolog/monolog": "^3.5",
        "symfony/http-foundation": "^6.4",
        "promphp/prometheus_client_php": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-symfony": "^1.3",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "php -d pcov.enabled=1 phpunit --coverage-text --coverage-clover coverage/coverage.xml",
        "coverage": "@test:coverage",
        "coverage:html": "php -d pcov.enabled=1 phpunit --coverage-html coverage/html",
        "lint": "phpstan analyse src --level=5 --memory-limit=512M",
        "lint:strict": "phpstan analyse src --level=8 --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@lint",
            "@test"
        ]
    }
}
